    ],
    [
     "",
     "Dynamik:",
     "Beitragssteigerung in einem festen Prozentsatz von mindestens 3% und höchstens 10% jährlich.Die letzte Dynamisierung erfolgt ein Jahr vor Ablauf der Beitragszahlungsdauer."
    ],
