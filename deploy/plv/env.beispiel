# Nach ~/apps/plv/.env kopieren und ausfuellen. Keine Geheimnisse hier.
GHCR_OWNER=<github-owner>
IMAGE_TAG=latest
# Nach jedem `docker compose pull` eintragen:
#   docker image inspect ghcr.io/<owner>/rechner-pipeline-plv:latest --format '{{index .RepoDigests 0}}'
IMAGE_DIGEST=
ZEITZONE=Europe/Berlin
# Besitzer von daten/ auf dem Betriebsrechner (id -u / id -g):
PLV_UID=1000
PLV_GID=1000
# Verzeichnis mit betrieb.key (0600, ein Hardlink) und zeichnungsordnung.json —
# ausserhalb von daten/, beim Menschen verwahrt wie die Rollenschluessel der
# Abnahmen. Hier steht nur der Pfad, nie der Schluessel:
BETRIEBSSCHLUESSEL_DIR=<pfad-zum-schluesselverzeichnis>
