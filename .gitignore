# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.hypothesis/
.venv/

# Scratch / agent fixture dirs
.tmp/

# EIN Laufverzeichnis fuer alle regenerierbaren Lauf-Artefakte
# (Extraktion, Gate-Ledger, Staging, Berichte)
/runs/
# Fall-Arbeitsbereiche (lokale Demo-Faelle; echte Faelle liegen ausserhalb
# des Repos — eingang/ ist dort NICHT regenerierbar, siehe ADR-002)
/faelle/
# Linienbereich der Erstabnahme des Zielsystems (ADR-025): Snapshots,
# Belege und Versionslinie der Zeichnungsordnung einer Installation —
# Klarnamen und installationsgebundenes Material, nicht regenerierbar
/linie/
# Artefakt-Simulationen der Showcase-Faelle (Regie-Bereich, ausserhalb
# des Systems)
/simulation
/regie/

# Lokale Overrides und private Notizen (.claude/skills/ bleibt getrackt)
.claude/settings.local.json
CLAUDE.local.md
docs-local/

# Secrets (Schutznetz — das Paket ist SDK-frei und braucht keine .env)
.env
.env.*

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Doku-Engine-Renderings (Quellen sind die Markdown-Dateien)
docs/**/*.pdf
werkzeuge/quellsystem/*.pdf
docs/**/*.typ
werkzeuge/quellsystem/*.typ
docs/**/*_files/

