# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.hypothesis/

# Virtual environment
.venv/

# Scratch / agent fixture dirs
.tmp/
.verify/
agent-comm.db*

# EIN Laufverzeichnis fuer alle regenerierbaren Lauf-Artefakte
# (Extraktion, generierter Kern, Gate-Ledger, Staging, Berichte)
runs/
# Fall-Arbeitsbereiche (lokale Demo-Faelle; echte Faelle liegen ausserhalb
