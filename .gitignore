# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.hypothesis/

# Virtual environment
.venv/

# Scratch / agent fixture dirs
.tmp/
.verify/
agent-comm.db*

# Regenerable pipeline run artifacts (produced by `extract` / `assurance`)
info_from_excel/
diagnostics/
generated/

# Local CLI settings (skills under .claude/skills/ ARE tracked)
.claude/settings.local.json

# Secrets
.env
.env.*

# Personal Claude Code overrides (CLAUDE.local.md is private; .claude/skills/ stays tracked)
CLAUDE.local.md

# Lokale, nicht eingecheckte Dokumentation (Notizen, Walkthroughs, Spickzettel)
docs-local/

# Legacy SDK-Pipeline run-Artefakte / Debug-Dumps (relevant im geparkten Branch)
runs/
DEBUG_*.txt

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Doku-Engine-Renderings (Quellen sind die Markdown-Dateien)
docs/**/*.pdf
docs/**/*.typ
docs/**/*_files/
